# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=development

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Backend API base (existing task API).
API_ENDPOINT=

# Portal server base URL for mentor limits API.
# Example: https://portal.example.com
PORTAL_ENDPOINT=

# Bearer token for opensource integration APIs on portal.
OPENSOURCE_INTEGRATION_TOKEN=

# Portal URL for student/mentor registration (used in bot comments).
# Example: https://internship.xuanwu.openatom.cn
INTERNSHIP_PORTAL_URL=
